# ---------------------------------------------------------------------------
# SportGo — environment template.  Copy to `.env.local` and fill in.
# NEVER commit a real .env file. No secret in this repo is a working credential.
# ---------------------------------------------------------------------------

# --- Runtime mode -----------------------------------------------------------
# "demo"  -> everything simulated, no real money, no real provider calls (default)
# "live"  -> requires every regulated integration below to be configured AND a
#            valid gambling licence for the target jurisdiction.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Jurisdiction / market --------------------------------------------------
NEXT_PUBLIC_JURISDICTION=TN
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_CURRENCY=TND
NEXT_PUBLIC_TIMEZONE=Africa/Tunis
NEXT_PUBLIC_LEGAL_AGE=18

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/sportgo?schema=public"

# --- Session / auth ---------------------------------------------------------
# 32+ byte random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=
SESSION_COOKIE_NAME=sportgo_session
SESSION_TTL_SECONDS=3600

# --- Regulated integrations (PLACEHOLDERS — not implemented) ----------------
# Sportsbook odds/data feed
SPORTS_FEED_PROVIDER=mock
SPORTS_FEED_BASE_URL=
SPORTS_FEED_API_KEY=

# Payment service provider (PCI-DSS compliant, hosted fields / redirect only).
# SportGo must never receive or store raw PAN / CVV data.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# KYC / AML identity verification provider
KYC_PROVIDER=mock
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=

# National self-exclusion register (jurisdiction-specific)
SELF_EXCLUSION_REGISTER_URL=
SELF_EXCLUSION_REGISTER_API_KEY=
