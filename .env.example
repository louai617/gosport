# ---------------------------------------------------------------------------
# SportGo — environment template.  Copy to `.env.local` and fill in.
#
# NEVER commit a real .env file. Nothing in this repo is a working credential:
# every secret below is generated by you and lives only in the environment
# (`.env.local` locally, the Vercel dashboard in production).
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# The URL scheme selects the engine; `npm run db:provider` (run automatically by
# build, postinstall and the db:* scripts) rewrites prisma/schema.prisma to match.
#
#   Local development  ->  SQLite, a file in the project root (git-ignored):
#     DATABASE_URL="file:./dev.db"
# PostgreSQL only: connections held per server instance (default 10). On Vercel keep it
# small (3-5) or use your provider's pooled connection string.
# DATABASE_POOL_MAX=5
# PostgreSQL behind a transaction pooler (Neon "-pooler", Supabase :6543, PgBouncer):
# put the pooled URL in DATABASE_URL and the direct one here. Used only by migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"
#   Production (Vercel) ->  PostgreSQL. SQLite is refused on Vercel because the
#   filesystem is read-only and ephemeral:
#     DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Secrets (required in production) ---------------------------------------
# Keys the session and one-time-token digests. 32+ chars: `openssl rand -base64 48`
# Rotating it signs every user out and invalidates outstanding reset links.
SESSION_SECRET=
# Salt for one-way hashing of IPs / e-mails in logs and rate-limit keys.
# 16+ chars: `openssl rand -base64 24`
PII_HASH_SALT=

# --- First administrator (read ONLY by `npm run db:seed`) --------------------
# The seed creates one ADMIN account from these and flags it "must change password",
# so the value here is only ever a one-time bootstrap secret. Unset them afterwards.
# Leave ADMIN_PASSWORD out and use `npm run admin:recovery-link -- <email>` instead
# if you would rather never type a password anywhere.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Session lifetimes (optional; seconds) ----------------------------------
# Idle timeout (dies this long after the last request) / absolute timeout.
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=86400
# Administrators get tighter windows than players.
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_COOKIE_NAME=sportgo_session
CSRF_COOKIE_NAME=sportgo_csrf

# --- Runtime mode and market (optional) -------------------------------------
# "demo" -> credits only, nothing real moves, no provider is called (default).
# "live" -> refuses to boot unless every regulated integration below is configured
#           AND a licence is recorded. No integration is implemented in this build,
#           so do not set it.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_JURISDICTION=TN
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_CURRENCY=TND
NEXT_PUBLIC_TIMEZONE=Africa/Tunis
NEXT_PUBLIC_LEGAL_AGE=18

# --- Regulated integrations (PLACEHOLDERS — not implemented) ----------------
# They exist so that `APP_MODE=live` can say precisely what is missing. Leave blank.
SPORTS_FEED_PROVIDER=mock
SPORTS_FEED_BASE_URL=
SPORTS_FEED_API_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
KYC_PROVIDER=mock
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=
SELF_EXCLUSION_REGISTER_URL=
SELF_EXCLUSION_REGISTER_API_KEY=
# Only ever set once a regulator has actually granted a licence.
LICENCE_AUTHORITY=
LICENCE_NUMBER=
LICENCE_VERIFY_URL=
