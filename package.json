{
  "name": "sportgo",
  "version": "0.1.0",
  "private": true,
  "description": "SportGo — sports betting & sports entertainment platform (DEMO / SIMULATION MODE)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prisma-provider.mjs && prisma generate && next build",
    "build:vercel": "node scripts/prisma-provider.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-provider.mjs && prisma generate",
    "db:provider": "node scripts/prisma-provider.mjs",
    "prisma:generate": "node scripts/prisma-provider.mjs && prisma generate",
    "prisma:format": "prisma format",
    "db:migrate": "node scripts/prisma-provider.mjs && prisma migrate dev",
    "db:deploy": "node scripts/prisma-provider.mjs && prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:recovery-link": "tsx --conditions=react-server scripts/admin-recovery-link.ts",
    "verify": "npm run typecheck && npm run check:boundary && npm run audit:i18n && npm run test:unit && npm run build",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "smoke": "bash scripts/smoke.sh",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "slot:rtp": "node --experimental-strip-types scripts/slot-rtp.ts",
    "test:unit": "tsx scripts/settlement-test.ts && tsx scripts/period-test.ts && tsx scripts/csv-test.ts",
    "test:integration": "tsx --conditions=react-server scripts/integration-test.mts",
    "casino:test": "node scripts/casino-test.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
