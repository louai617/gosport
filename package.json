{
  "name": "sportgo",
  "version": "0.1.0",
  "private": true,
  "description": "SportGo \u2014 sports betting & sports entertainment platform (DEMO / SIMULATION MODE)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "verify": "npm run typecheck && npm run check:boundary && npm run audit:i18n && npm run build",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "smoke": "bash scripts/smoke.sh",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "slot:rtp": "node --experimental-strip-types scripts/slot-rtp.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
