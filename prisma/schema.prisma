// =============================================================================
// SportGo — PostgreSQL schema
// -----------------------------------------------------------------------------
// This schema is the deployment target, not the running data source. The demo
// build serves every screen from the in-memory provider in `src/data`; nothing
// in the application currently reads or writes Postgres. See docs/DATABASE.md.
//
// Conventions applied throughout — a reviewer should be able to assume these
// without re-deriving them per model:
//
//   • Money is NEVER a float. Every monetary column is Decimal(18, 3): the
//     Tunisian dinar has three minor digits (millimes), and binary floating
//     point cannot represent 0.001 exactly, so a float ledger drifts and stops
//     reconciling. 18 total digits leaves headroom far beyond any real balance.
//   • Odds are Decimal(10, 3) for the same reason — a price of 1.833 must round
//     trip exactly from feed to bet slip to settlement.
//   • Timestamps are `timestamptz`. Postgres' bare `timestamp` (Prisma's
//     default) silently drops the offset, which breaks settlement windows and
//     responsible-gambling cooling-off periods across DST.
//   • Enum members are SCREAMING_SNAKE but map to the exact string literal used
//     in `src/types/**`, so the database value, the API payload and the
//     TypeScript union are the same token — no translation layer, no drift.
//   • Postgres does not index foreign keys automatically; every FK below has an
//     explicit index, either its own or as the leading column of a composite.
//   • Identifiers are cuids generated by the application so a row can be
//     referenced (in logs, in an idempotency key) before it is inserted.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

// The connection string is deliberately absent. Prisma 7 rejects `url` in this
// block outright (P1012): migrations read `DATABASE_URL` from a `prisma.config.ts`
// and the runtime gets it from a driver adapter handed to `PrismaClient` (see
// `src/server/db.ts`). Neither exists yet — nothing here has ever been migrated —
// and both are listed in docs/DATABASE.md as launch prerequisites. The upside is
// that the schema carries nothing environment-specific.
datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums — one per status union in `src/types/**`
// =============================================================================

/// Roles are mutually exclusive and few, so they live in a column rather than a
/// `UserRole` join table: authorisation then costs one already-loaded field
/// instead of a join on every request. A join table only earns its complexity
/// once a user can hold several roles or per-permission grants, which is a
/// forward migration (add table, backfill from this column) rather than a
/// design we should pay for today.
enum Role {
  PLAYER  @map("player")
  SUPPORT @map("support")
  TRADER  @map("trader")
  ADMIN   @map("admin")
}

enum AccountStatus {
  ACTIVE        @map("active")
  RESTRICTED    @map("restricted")
  SELF_EXCLUDED @map("self_excluded")
  CLOSED        @map("closed")
}

enum KycStatus {
  NOT_STARTED @map("not_started")
  PENDING     @map("pending")
  VERIFIED    @map("verified")
  REJECTED    @map("rejected")
  EXPIRED     @map("expired")
}

enum SportKey {
  FOOTBALL   @map("football")
  BASKETBALL @map("basketball")
  TENNIS     @map("tennis")
  HANDBALL   @map("handball")
  VOLLEYBALL @map("volleyball")
  RUGBY      @map("rugby")
  BOXING     @map("boxing")
  FORMULA1   @map("formula1")
}

enum EventStatus {
  SCHEDULED @map("scheduled")
  LIVE      @map("live")
  FINISHED  @map("finished")
  CANCELLED @map("cancelled")
  POSTPONED @map("postponed")
}

enum MarketKey {
  ONE_X_TWO     @map("1x2")
  DOUBLE_CHANCE @map("double_chance")
  OVER_UNDER    @map("over_under")
  BTTS          @map("btts")
  MONEYLINE     @map("moneyline")
  HANDICAP      @map("handicap")
  TOTAL_POINTS  @map("total_points")
  CORRECT_SCORE @map("correct_score")
  NEXT_GOAL     @map("next_goal")
  MATCH_WINNER  @map("match_winner")
}

enum MarketStatus {
  OPEN      @map("open")
  SUSPENDED @map("suspended")
  SETTLED   @map("settled")
  CLOSED    @map("closed")
}

enum SelectionOutcome {
  HOME         @map("home")
  DRAW         @map("draw")
  AWAY         @map("away")
  OVER         @map("over")
  UNDER        @map("under")
  YES          @map("yes")
  NO           @map("no")
  HOME_OR_DRAW @map("home_or_draw")
  HOME_OR_AWAY @map("home_or_away")
  DRAW_OR_AWAY @map("draw_or_away")
  OTHER        @map("other")
}

enum OddsMovement {
  UP   @map("up")
  DOWN @map("down")
  NONE @map("none")
}

/// Per-selection settlement outcome. Distinct from `BetStatus`: a leg can be
/// voided (event abandoned) while the bet itself stays open with that leg's
/// odds collapsed to 1.000.
enum SelectionResult {
  PENDING @map("pending")
  WON     @map("won")
  LOST    @map("lost")
  VOID    @map("void")
}

enum BetMode {
  SINGLE   @map("single")
  MULTIPLE @map("multiple")
  SYSTEM   @map("system")
}

enum BetStatus {
  PENDING    @map("pending")
  WON        @map("won")
  LOST       @map("lost")
  CANCELLED  @map("cancelled")
  CASHED_OUT @map("cashed_out")
  VOID       @map("void")
}

enum PaymentMethodKind {
  CARD          @map("card")
  BANK_TRANSFER @map("bank_transfer")
  MOBILE_MONEY  @map("mobile_money")
  E_WALLET      @map("e_wallet")
  VOUCHER       @map("voucher")
}

enum PaymentMethodStatus {
  AVAILABLE   @map("available")
  COMING_SOON @map("coming_soon")
  UNAVAILABLE @map("unavailable")
}

enum PaymentInstrumentStatus {
  PENDING @map("pending")
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REMOVED @map("removed")
}

enum TransactionKind {
  DEPOSIT    @map("deposit")
  WITHDRAWAL @map("withdrawal")
  BET_STAKE  @map("bet_stake")
  BET_PAYOUT @map("bet_payout")
  BONUS      @map("bonus")
  REFUND     @map("refund")
  ADJUSTMENT @map("adjustment")
}

enum TransactionStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
  REVERSED   @map("reversed")
}

enum PromotionKind {
  WELCOME  @map("welcome")
  SPORT    @map("sport")
  WEEKEND  @map("weekend")
  LIVE     @map("live")
  LOYALTY  @map("loyalty")
  SEASONAL @map("seasonal")
}

enum PromotionStatus {
  ACTIVE    @map("active")
  SCHEDULED @map("scheduled")
  EXPIRED   @map("expired")
  DISABLED  @map("disabled")
}

enum PromotionClaimStatus {
  CLAIMED  @map("claimed")
  CREDITED @map("credited")
  WAGERING @map("wagering")
  COMPLETE @map("complete")
  EXPIRED  @map("expired")
  REVOKED  @map("revoked")
}

enum NotificationKind {
  MATCH_STARTING       @map("match_starting")
  BET_SETTLED          @map("bet_settled")
  PROMOTION            @map("promotion")
  ACCOUNT              @map("account")
  RESPONSIBLE_GAMBLING @map("responsible_gambling")
}

enum FavoriteKind {
  SPORT       @map("sport")
  COMPETITION @map("competition")
  TEAM        @map("team")
  EVENT       @map("event")
}

enum LimitKind {
  DEPOSIT          @map("deposit")
  STAKE            @map("stake")
  LOSS             @map("loss")
  SESSION_DURATION @map("session_duration")
  SINGLE_BET       @map("single_bet")
}

enum LimitPeriod {
  DAILY   @map("daily")
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")
}

enum ExclusionKind {
  COOLING_OFF    @map("cooling_off")
  SELF_EXCLUSION @map("self_exclusion")
}

// =============================================================================
// Identity & access
// =============================================================================

model User {
  id String @id @default(cuid())

  email String @unique
  phone String @unique

  /// Argon2id (bcrypt only as a fallback where Argon2 is unavailable, and then
  /// rehashed to Argon2id on the next successful sign-in). The plaintext
  /// password exists only inside the request handler that receives it: it is
  /// never logged, never stored, never placed on a queue and never sent to a
  /// third party. The parameters are encoded in the hash string itself so cost
  /// can be raised without a migration.
  passwordHash String

  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  countryCode String   @db.Char(2)
  locale      String   @default("fr") @db.VarChar(5)

  role      Role          @default(PLAYER)
  status    AccountStatus @default(ACTIVE)
  kycStatus KycStatus     @default(NOT_STARTED)

  /// The user ticking "I am over 18". A declaration, never a verification —
  /// only a KycRecord in VERIFIED state proves age.
  ageDeclaredAt DateTime? @db.Timestamptz(3)

  emailVerified    Boolean @default(false)
  phoneVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  /// Handle for the TOTP secret held in the secrets manager. The secret itself
  /// must never sit in an application table.
  twoFactorSecretRef String?

  lastLoginAt DateTime? @db.Timestamptz(3)

  /// Erasure marker. Financial and audit rows are retention-bound and block a
  /// hard DELETE (see the Restrict relations below), so a right-to-erasure
  /// request is served by pseudonymising the columns above and stamping this.
  deletedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  wallet        Wallet?
  instruments   PaymentInstrument[]
  bets          Bet[]
  transactions  Transaction[]
  notifications Notification[]
  favorites     Favorite[]
  limits        ResponsibleGamblingLimit[]
  exclusions    SelfExclusion[]
  kycRecords    KycRecord[]
  claims        PromotionClaim[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id     String @id @default(cuid())
  userId String

  /// SHA-256 of the opaque session token. The token itself is returned once, in
  /// a Set-Cookie header, and never written down: a dump of this table cannot
  /// be replayed to impersonate anyone. Lookup hashes the presented cookie and
  /// matches on this column — hence the unique constraint, which doubles as the
  /// lookup index (a separate @@index would be redundant).
  tokenHash String @unique

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  /// Truncated HMAC of the client IP, not the address. Enough to spot a session
  /// hopping continents, not enough to rebuild a location history.
  ipHash     String?
  userAgent  String?
  lastSeenAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// Sportsbook catalogue
//
// `eventCount` / `liveEventCount` / `marketCount` are denormalised read-model
// counters maintained by the feed sync. They exist so navigation renders in one
// query; they are never authoritative and a nightly job recomputes them.
// =============================================================================

model Sport {
  id  String   @id @default(cuid())
  key SportKey @unique

  nameKey String
  icon    String

  /// `order` is a reserved word in SQL, so the column is named `sort_order` to
  /// keep hand-written queries and BI tools quote-free.
  order Int @map("sort_order")

  eventCount     Int @default(0)
  liveEventCount Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  competitions Competition[]
  events       Event[]

  @@index([order])
  @@map("sports")
}

model Country {
  id   String @id @default(cuid())
  code String @unique @db.Char(2)

  nameKey String
  /// Unicode regional-indicator pair. Decorative only — always aria-hidden.
  flag    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  competitions Competition[]
  teams        Team[]

  @@map("countries")
}

model Competition {
  id        String @id @default(cuid())
  sportId   String
  countryId String

  /// Proper noun. Displayed as-is; never routed through i18n.
  name      String
  shortName String
  slug      String

  popular  Boolean @default(false)
  monogram String  @db.VarChar(2)
  hue      Int

  eventCount     Int @default(0)
  liveEventCount Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sport   Sport   @relation(fields: [sportId], references: [id], onDelete: Restrict)
  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  events  Event[]

  @@unique([sportId, slug])
  @@index([sportId, popular])
  @@index([countryId])
  @@map("competitions")
}

model Team {
  id        String @id @default(cuid())
  countryId String

  name      String
  shortName String
  code      String @db.Char(3)
  monogram  String @db.VarChar(2)
  hue       Int

  /// Only ever a locally hosted, licence-cleared asset. Null in demo mode, in
  /// which case the UI draws a generated placeholder crest.
  crestUrl String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  country    Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  homeEvents Event[] @relation("HomeTeamEvents")
  awayEvents Event[] @relation("AwayTeamEvents")

  @@index([countryId])
  @@index([name])
  @@map("teams")
}

model Event {
  id            String @id @default(cuid())
  sportId       String
  competitionId String
  homeTeamId    String
  awayTeamId    String

  startTime DateTime    @db.Timestamptz(3)
  status    EventStatus @default(SCHEDULED)

  featured    Boolean @default(false)
  hasTracker  Boolean @default(false)
  marketCount Int     @default(0)

  scoreHome Int?
  scoreAway Int?
  /// Per-period breakdown (`[{ labelKey, home, away }]`). Shape varies by sport
  /// and is only ever read whole, so it stays JSON rather than a table.
  periods   Json?

  liveMinute    Int?
  livePeriodKey String?
  liveProgress  Int?
  liveAddedTime Int?

  /// Upstream feed identifier, kept so a re-sync updates rather than duplicates.
  externalRef String?   @unique
  settledAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sport       Sport       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  homeTeam    Team        @relation("HomeTeamEvents", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam    Team        @relation("AwayTeamEvents", fields: [awayTeamId], references: [id], onDelete: Restrict)
  markets     Market[]
  selections  Selection[]

  @@index([sportId, startTime])
  @@index([status, startTime])
  @@index([competitionId, startTime])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([featured, startTime])
  @@map("events")
}

model Market {
  id      String @id @default(cuid())
  eventId String

  key      MarketKey
  nameKey  String
  groupKey String
  status   MarketStatus @default(OPEN)

  /// Handicap or total line (2.5, -1.75). Decimal, not float: a quarter-line
  /// compared with `==` after a float round-trip is a settlement dispute.
  line Decimal? @db.Decimal(6, 2)

  order     Int       @map("sort_order")
  settledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([eventId])
  @@index([status])
  @@map("markets")
}

model Selection {
  id       String @id @default(cuid())
  marketId String
  /// Denormalised from the market so the bet slip and settlement can filter by
  /// event without joining through `markets`.
  eventId  String

  outcome  SelectionOutcome
  /// Exactly one of these is set: `labelKey` when the label is translatable,
  /// `label` when it is a proper noun (a team name).
  labelKey String?
  label    String?

  odds         Decimal         @db.Decimal(10, 3)
  previousOdds Decimal?        @db.Decimal(10, 3)
  movement     OddsMovement    @default(NONE)
  active       Boolean         @default(true)
  result       SelectionResult @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  market        Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  betSelections BetSelection[]

  @@index([marketId])
  @@index([eventId, result])
  @@map("selections")
}

// =============================================================================
// Betting
// =============================================================================

model Bet {
  id String @id @default(cuid())

  /// Short human-quotable reference (`SG-4F2A19`) used in support tickets.
  reference String @unique
  userId    String

  mode       BetMode
  /// Size of each combination for a system bet (the 2 in "2/3"); null otherwise.
  systemSize Int?

  stake           Decimal  @db.Decimal(18, 3)
  totalOdds       Decimal  @db.Decimal(10, 3)
  potentialReturn Decimal  @db.Decimal(18, 3)
  /// Null while the bet is open, then set once — 0.000 on a loss, so a settled
  /// bet always carries an explicit figure rather than an absence.
  payout          Decimal? @db.Decimal(18, 3)
  cashOutAmount   Decimal? @db.Decimal(18, 3)
  currency        String   @default("TND") @db.VarChar(3)

  status    BetStatus @default(PENDING)
  placedAt  DateTime  @default(now()) @db.Timestamptz(3)
  settledAt DateTime? @db.Timestamptz(3)

  /// True for every row this build can produce. A live deployment must fail
  /// loudly rather than silently flip it.
  simulated Boolean @default(true)

  /// Hash of the client-supplied idempotency key, so a retried placement
  /// returns the original bet instead of doubling the stake.
  idempotencyKey String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  selections   BetSelection[]
  transactions Transaction[]

  @@index([userId, status, placedAt])
  @@index([status, settledAt])
  @@map("bets")
}

model BetSelection {
  id          String @id @default(cuid())
  betId       String
  selectionId String

  /// Price the user accepted, frozen at placement. `Selection.odds` keeps
  /// moving; settlement must use this column and nothing else.
  oddsAtPlacement Decimal @db.Decimal(10, 3)

  /// Display snapshot so a bet history row renders without joining five tables,
  /// and still reads correctly after a competition is renamed or an event is
  /// purged by retention.
  eventLabel       String
  competitionLabel String
  marketNameKey    String
  selectionLabel   String
  startTime        DateTime @db.Timestamptz(3)

  status BetStatus @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Restrict)

  @@unique([betId, selectionId])
  @@index([betId])
  @@index([selectionId])
  @@map("bet_selections")
}

// =============================================================================
// Wallet & payments
// =============================================================================

/// One wallet per user.
///
/// `withdrawable` from the TypeScript model is deliberately not a column: it is
/// `balance - reserved - unmet bonus wagering`, derived on read so it can never
/// drift from the three inputs it is made of.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  currency String @default("TND") @db.VarChar(3)

  /// Materialised cache of the ledger tail, not the source of truth. The
  /// authoritative balance is `balanceAfter` on the newest completed
  /// Transaction; this column exists so a page load is one row read. Every
  /// mutation happens inside the transaction that appends the ledger row, under
  /// `SELECT ... FOR UPDATE` on this row, and a reconciliation job asserts the
  /// two agree. See docs/DATABASE.md.
  balance      Decimal @db.Decimal(18, 3)
  /// Funds held against unsettled bets.
  reserved     Decimal @default(0) @db.Decimal(18, 3)
  bonusBalance Decimal @default(0) @db.Decimal(18, 3)

  /// Optimistic-concurrency counter, bumped on every balance write. `FOR UPDATE`
  /// is what actually serialises settlement; this is the second line of defence
  /// for the read-modify-write paths that legitimately run without the row lock
  /// (a bonus sweep, an admin adjustment) — they update `WHERE version = $read`
  /// and retry on zero rows affected.
  version Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@map("wallets")
}

/// Catalogue of payment rails the operator offers. This is configuration, not
/// user data — it holds no credentials of any kind.
model PaymentMethod {
  id   String @id @default(cuid())
  code String @unique

  kind           PaymentMethodKind
  nameKey        String
  descriptionKey String
  icon           String
  status         PaymentMethodStatus @default(COMING_SOON)

  supportsDeposit    Boolean @default(false)
  supportsWithdrawal Boolean @default(false)

  minAmount Decimal @db.Decimal(18, 3)
  maxAmount Decimal @db.Decimal(18, 3)

  processingTimeKey String
  /// PSP that would execute the movement. `mock` in this build.
  provider          String  @default("mock")
  requiresKyc       Boolean @default(true)
  order             Int     @map("sort_order")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  instruments  PaymentInstrument[]
  transactions Transaction[]

  @@index([status, order])
  @@map("payment_methods")
}

/// A rail a specific user has saved.
///
/// SportGo is out of PCI-DSS scope by construction: card details are entered
/// into the provider's hosted fields and never reach this application, so there
/// is no column here (or anywhere) for a PAN, a CVV, a full IBAN or a mobile
/// wallet PIN. What we keep is the provider's token — useless without the
/// provider's credentials — plus the display-safe fragments needed to let a
/// user tell two saved cards apart.
model PaymentInstrument {
  id       String @id @default(cuid())
  userId   String
  methodId String

  /// Opaque vault reference issued by the PSP. Unique so a re-tokenisation
  /// cannot silently create a duplicate instrument.
  providerTokenRef String @unique
  provider         String @default("mock")

  /// e.g. "•••• 4242" or "•••• 8891" — already masked, safe to render.
  displayLabel String
  last4        String? @db.Char(4)
  brand        String?
  expiryMonth  Int?
  expiryYear   Int?

  status     PaymentInstrumentStatus @default(PENDING)
  isDefault  Boolean                 @default(false)
  verifiedAt DateTime?               @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([methodId])
  @@map("payment_instruments")
}

/// Append-only ledger. Rows are inserted, never updated in place except to
/// advance `status` through its terminal state (a reversal is a new,
/// compensating row — we do not rewrite history). `balanceAfter` makes every
/// row self-describing, so an auditor can verify the running balance without
/// replaying the whole table, and so a corrupted cache in `wallets` can be
/// rebuilt from here.
///
/// Balance is *derived from this table*. `wallets.balance` is a cache of the
/// ledger tail and is never mutated on its own: every write to it happens inside
/// the same transaction that appends the row explaining it.
model Transaction {
  id        String @id @default(cuid())
  reference String @unique

  /// `userId` is denormalised from the wallet. A user has exactly one wallet
  /// today, but every statement, limit check and regulatory extract is scoped by
  /// player, and carrying the column keeps those off a join on the largest table
  /// in the database.
  userId   String
  walletId String

  kind   TransactionKind
  status TransactionStatus @default(PENDING)

  /// Signed: positive credits the wallet, negative debits it. Summing the
  /// completed rows for a user must equal `balanceAfter` of the newest one.
  amount       Decimal @db.Decimal(18, 3)
  currency     String  @default("TND") @db.VarChar(3)
  balanceAfter Decimal @db.Decimal(18, 3)

  methodId         String?
  betId            String?
  promotionClaimId String?

  /// PSP-side identifier, used only to reconcile our ledger against theirs.
  /// It is an opaque handle: never a PAN, a CVV, an IBAN or an account number,
  /// none of which this application is ever sent.
  providerRef    String?
  descriptionKey String
  params         Json?
  /// i18n key for a failure reason — never a raw provider message.
  failureKey     String?

  simulated   Boolean   @default(true)
  completedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// Present for schema uniformity only; ledger rows are not edited.
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  method PaymentMethod?  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  bet    Bet?            @relation(fields: [betId], references: [id], onDelete: Restrict)
  claim  PromotionClaim? @relation(fields: [promotionClaimId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@index([walletId, createdAt])
  @@index([methodId])
  @@index([betId])
  @@index([promotionClaimId])
  @@index([providerRef])
  @@map("transactions")
}

// =============================================================================
// Promotions
// =============================================================================

model Promotion {
  id   String @id @default(cuid())
  slug String @unique

  kind            PromotionKind
  titleKey        String
  summaryKey      String
  descriptionKey  String
  /// i18n keys rendered as bullet lists.
  eligibilityKeys String[]
  termsKeys       String[]

  status   PromotionStatus @default(SCHEDULED)
  startsAt DateTime        @db.Timestamptz(3)
  endsAt   DateTime?       @db.Timestamptz(3)

  ctaHref     String
  ctaLabelKey String
  hue         Int
  featured    Boolean @default(false)

  /// Illustrative only. Nothing here is redeemable and none of it is a
  /// financial promotion.
  simulated Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  claims PromotionClaim[]

  @@index([status, startsAt])
  @@index([featured, status])
  @@map("promotions")
}

model PromotionClaim {
  id          String @id @default(cuid())
  userId      String
  promotionId String

  status PromotionClaimStatus @default(CLAIMED)

  bonusAmount         Decimal? @db.Decimal(18, 3)
  wageringRequirement Decimal? @db.Decimal(18, 3)
  wageringProgress    Decimal  @default(0) @db.Decimal(18, 3)

  claimedAt  DateTime  @default(now()) @db.Timestamptz(3)
  creditedAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion    Promotion     @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  // One claim per user per promotion. The constraint, not a service-layer
  // check, is what stops a double-credit under concurrency.
  @@unique([userId, promotionId])
  @@index([userId, status])
  @@index([promotionId])
  @@map("promotion_claims")
}

// =============================================================================
// Engagement
// =============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  kind     NotificationKind
  titleKey String
  bodyKey  String
  /// Interpolation values for the two keys above.
  params   Json?
  href     String?

  read   Boolean   @default(false)
  readAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Favorite {
  id     String       @id @default(cuid())
  userId String
  kind   FavoriteKind

  /// Points at a sport, competition, team or event depending on `kind`. Four
  /// possible parents means no single FK can express it; the service layer
  /// validates the target on write and a sweep drops orphans.
  targetId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId, kind])
  @@map("favorites")
}

// =============================================================================
// Responsible gambling & compliance
// =============================================================================

model ResponsibleGamblingLimit {
  id     String @id @default(cuid())
  userId String

  kind   LimitKind
  period LimitPeriod

  /// A money amount for deposit/stake/loss/single_bet limits, and whole minutes
  /// for `session_duration`. One Decimal column serves both exactly.
  value Decimal @db.Decimal(18, 3)
  /// Consumed within the current window; reset when `windowStartedAt` rolls.
  used  Decimal @default(0) @db.Decimal(18, 3)

  active          Boolean  @default(true)
  effectiveFrom   DateTime @default(now()) @db.Timestamptz(3)
  windowStartedAt DateTime @default(now()) @db.Timestamptz(3)

  /// Pending-increase flow: a decrease applies immediately by overwriting
  /// `value`, while an increase is parked here until the cooling-off window
  /// elapses. Keeping the future value in its own column means the effective
  /// limit is always `value` — no read path has to reason about dates.
  pendingValue         Decimal?  @db.Decimal(18, 3)
  pendingEffectiveFrom DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, active])
  @@index([pendingEffectiveFrom])
  @@map("rg_limits")
}

model SelfExclusion {
  id     String @id @default(cuid())
  userId String

  kind      ExclusionKind
  startedAt DateTime      @default(now()) @db.Timestamptz(3)
  /// Null means indefinite — a permanent self-exclusion with no end date.
  /// There is deliberately no "revoked" column: an exclusion cannot be lifted
  /// early, and lifting one at expiry is a support workflow that writes a new
  /// row and an audit entry, not an edit to this one.
  endsAt    DateTime?     @db.Timestamptz(3)

  registeredExternally Boolean @default(false)
  /// Reference returned by a national self-exclusion register. Never populated
  /// in this build — no such integration exists here.
  externalRegisterRef  String?
  reasonKey            String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([endsAt])
  @@map("self_exclusions")
}

/// Outcome of an identity check, and nothing else.
///
/// There is no column for a document image, a passport or CNI number, a
/// selfie, or a scan reference that could be resolved to one. Those artefacts
/// stay inside the verification provider, which is built and audited to hold
/// them; SportGo keeps only the decision it needs to gate withdrawals. A breach
/// of this table therefore exposes no identity document belonging to anyone,
/// and there is no retention obligation on data we never took.
model KycRecord {
  id     String @id @default(cuid())
  userId String

  provider    String @default("mock")
  /// Opaque case id at the provider. Resolvable only with provider credentials.
  providerRef String

  status KycStatus @default(NOT_STARTED)

  submittedAt DateTime? @db.Timestamptz(3)
  decidedAt   DateTime? @db.Timestamptz(3)
  /// Verifications lapse; a stale VERIFIED is not a verification.
  expiresAt   DateTime? @db.Timestamptz(3)
  /// i18n key. Never the provider's raw reason string, which can quote
  /// document contents.
  failureKey  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([userId, status])
  @@map("kyc_records")
}

// =============================================================================
// Platform infrastructure
// =============================================================================

/// Append-only. Nothing in the application may UPDATE or DELETE a row here;
/// the database role used by the app should hold INSERT and SELECT on this
/// table only. `updatedAt` exists for schema uniformity and will always equal
/// `createdAt`. Retention is set by the gambling regulator, not by us — see
/// docs/DATABASE.md.
model AuditLog {
  id String @id @default(cuid())

  /// Null for system-originated actions (settlement jobs, feed sync).
  actorId   String?
  actorRole Role?

  /// Verb in the past tense, namespaced: `bet.placed`, `limit.increase_scheduled`.
  action     String
  entityType String
  entityId   String

  /// State captured either side of the change. PII is redacted before it is
  /// written — an audit trail records that an email changed, not what to.
  before Json?
  after  Json?

  ipHash    String?
  userAgent String?
  /// Correlates the entry with the API request that produced it.
  requestId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// SetNull rather than Cascade: an actor being erased must not erase the
  /// record of what they did.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Fixed-window rate limiting, persisted so the limit survives a deploy and
/// holds across instances.
model RateLimitCounter {
  id String @id @default(cuid())

  /// What is being limited: `auth.login`, `bet.place`, `wallet.deposit`.
  scope          String
  /// HMAC of the IP, user id or email being counted. Hashed so this table
  /// cannot be read as a directory of who used the site and when.
  identifierHash String

  windowStart DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // The unique key is what makes the increment atomic: upsert on conflict,
  // never read-then-write.
  @@unique([scope, identifierHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}
