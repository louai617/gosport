// =============================================================================
// SportGo — database schema
// -----------------------------------------------------------------------------
// ONE schema, TWO databases:
//
//   development   DATABASE_URL="file:./dev.db"          → SQLite  (libsql driver)
//   production    DATABASE_URL="postgresql://…"         → PostgreSQL (pg driver)
//
// Prisma fixes the `provider` at generate time, so `scripts/prisma-provider.mjs`
// rewrites the single `provider = "…"` line below from the scheme of
// DATABASE_URL before every `prisma generate` / `migrate`. Nothing else in this
// file is provider-specific, and that is deliberate — it is why:
//
//   • Money is `BigInt` MILLIMES (1 TND = 1000), never Float or Decimal.
//     `@db.Decimal(…)` does not exist on SQLite, and a float ledger drifts. An
//     integer column behaves identically on both engines and sums exactly.
//   • There are no `@db.*` native-type attributes anywhere.
//   • Identifiers are application-generated cuids, so a row can be referenced
//     (in a log line, an idempotency key) before it is inserted.
//   • Enums are real enums on both engines (Prisma ≥ 6.2 supports them on SQLite).
//
// Migrations are provider-specific SQL, so they live in separate folders:
//   prisma/migrations/sqlite/     prisma/migrations/postgresql/
// `prisma.config.ts` picks the folder from the same DATABASE_URL.
//
// Invariants the application cannot enforce on its own are enforced by the
// database in the migrations (CHECK constraints and triggers):
//   • Wallet.balance >= 0
//   • Transaction rows are append-only apart from a PENDING → final status move
//   • AuditLog rows can never be updated or deleted
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// =============================================================================
// Enums
// =============================================================================

/// Roles are a column, not a join table: authorisation is one already-loaded
/// field. To add a staff role (SUPPORT, TRADER, …) add a member here and a row
/// in `ROLE_PERMISSIONS` (src/server/auth/permissions.ts) — nothing else moves.
enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  /// Invited by an administrator; has not set a password yet. Cannot sign in.
  PENDING
  ACTIVE
  /// Suspended by an administrator, with a reason. Cannot sign in.
  SUSPENDED
  /// Security lock — manual, or automatic after repeated failed sign-ins.
  LOCKED
  /// Player-initiated. May sign in, view history and withdraw; may not wager.
  SELF_EXCLUDED
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET
  WIN
  REFUND
  BONUS
  ADMIN_CREDIT
  ADMIN_DEBIT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum BetKind {
  SPORTS
  CASINO
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
  CASHED_OUT
}

enum LegStatus {
  OPEN
  WON
  LOST
  VOID
}

enum LimitKind {
  DEPOSIT
  STAKE
  LOSS
  SINGLE_BET
}

enum LimitPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum ExclusionKind {
  COOLING_OFF
  SELF_EXCLUSION
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITATION
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  BLOCKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// Identity
// =============================================================================

model User {
  id                 String     @id @default(cuid())
  /// Stored lower-case. Unique.
  username           String     @unique
  /// Stored lower-case. Unique.
  email              String     @unique
  phone              String?
  /// Argon2id PHC string. Never selected into a view model, never logged.
  passwordHash       String
  role               Role       @default(PLAYER)
  status             UserStatus @default(ACTIVE)
  /// Forces a password change before anything else — set for the seeded admin
  /// and for accounts created with an administrator-chosen password.
  mustChangePassword Boolean    @default(false)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  emailVerifiedAt    DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  /// The administrator who created the account, when it was not self-registered.
  createdById        String?

  createdBy  User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  profile       PlayerProfile?
  wallet        Wallet?
  sessions      Session[]
  tokens        PasswordToken[]
  transactions  Transaction[]
  bets          Bet[]
  limits        ResponsibleGamblingLimit[]
  exclusions    SelfExclusion[]
  notifications Notification[]
  favorites     Favorite[]
  fairnessSeeds FairnessSeed[]
  adjustmentRequests AdjustmentRequest[] @relation("AdjustmentSubject")
  auditAsActor  AuditLog[] @relation("AuditActor")
  auditAsTarget AuditLog[] @relation("AuditTarget")

  @@index([role, status])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([phone])
}

model PlayerProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  displayName         String
  firstName           String
  lastName            String
  /// Declared date of birth (UTC midnight). Stored only because an age gate is
  /// a legal requirement; it is a declaration, not a verification.
  dateOfBirth         DateTime?
  countryCode         String    @default("TN")
  locale              String    @default("fr")
  kycStatus           KycStatus @default(NOT_STARTED)
  ageDeclaredAt       DateTime?
  termsAcceptedAt     DateTime?
  marketingOptIn      Boolean   @default(false)
  /// Account restrictions — independent of `User.status`, so a player can be
  /// blocked from wagering while still able to sign in and withdraw.
  wageringBlocked     Boolean   @default(false)
  withdrawalsBlocked  Boolean   @default(false)
  restrictionReason   String?
  restrictedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kycStatus])
  @@index([countryCode])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  /// HMAC-SHA256 of the cookie token. The token itself is never stored.
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?
  ipHash            String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

/// One-time, expiring tokens: password reset and account invitation.
model PasswordToken {
  id          String       @id @default(cuid())
  userId      String
  purpose     TokenPurpose
  /// HMAC-SHA256 of the token handed to the user.
  tokenHash   String       @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime     @default(now())
  createdById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// =============================================================================
// Wallet & ledger
// =============================================================================

/// One wallet per user. `balance` is a cache of the ledger, updated only in the
/// same database transaction that appends the ledger row, and only through a
/// guarded atomic update (see src/server/wallet/ledger.ts). It is never written
/// from a request body.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("TND")
  /// Millimes. A CHECK constraint (migration) forbids a negative value.
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
}

/// The ledger. Append-only: monetary columns are never updated, and the only
/// permitted mutation is moving a PENDING row to its final status (migration
/// trigger). Corrections are new rows that point back through `relatedId`.
model Transaction {
  id             String            @id @default(cuid())
  /// Human-facing, unique, e.g. TX-7K2M9QXA.
  reference      String            @unique
  userId         String
  walletId       String
  type           TransactionType
  status         TransactionStatus @default(COMPLETED)
  /// Signed millimes: credits positive, debits negative.
  amount         BigInt
  balanceBefore  BigInt
  balanceAfter   BigInt
  /// Player-safe description. Internal reasons live in `metadata` and the audit log.
  description    String?
  /// Dedupes retried requests: (userId, idempotencyKey) is unique.
  idempotencyKey String?
  /// The actor who caused the entry — an administrator for manual operations,
  /// the player (or null) for system-generated ones.
  createdById    String?
  betId          String?
  /// For a reversal / refund: the entry it compensates.
  relatedId      String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  /// Set when a PENDING row reaches a final status.
  settledAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  bet    Bet?   @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([betId])
  @@index([walletId])
}

/// A manual adjustment above the configured threshold waits here until a
/// *different* administrator approves it (four-eyes). Approving executes it
/// through the same ledger function as any other adjustment.
model AdjustmentRequest {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  /// Signed millimes.
  amount        BigInt
  reason        String
  reference     String?
  status        ApprovalStatus  @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  transactionId String?
  createdAt     DateTime        @default(now())

  user User @relation("AdjustmentSubject", fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
}

// =============================================================================
// Wagering
// =============================================================================

/// A sportsbook ticket or a casino round. Casino rounds that span several
/// requests (blackjack, mines, crash) keep their private game state in `state`,
/// which is never serialised to a client.
model Bet {
  id             String    @id @default(cuid())
  reference      String    @unique
  userId         String
  kind           BetKind
  /// Casino only: slots, blackjack, roulette, dice, …
  gameKey        String?
  /// Sports only: single | multiple | system.
  mode           String?
  systemSize     Int?
  status         BetStatus @default(OPEN)
  /// Total wagered, millimes. Grows when a blackjack hand is doubled or split.
  stake          BigInt
  /// Combined price in milli-odds (1.833 → 1833). Sports only.
  totalOddsMilli Int?
  potentialReturn BigInt?
  payout         BigInt?
  placedAt       DateTime  @default(now())
  settledAt      DateTime?
  settledById    String?
  /// Bumped by every state change, so two concurrent requests on one round
  /// cannot both apply: the loser's conditional update matches no row.
  version        Int       @default(0)
  /// Server-private game state. Never sent to a client.
  state          Json?
  /// Public, player-visible outcome summary.
  result         Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legs         BetLeg[]
  transactions Transaction[]

  @@index([userId, placedAt])
  @@index([kind, status])
  @@index([status, placedAt])
  @@index([placedAt])
}

/// A sportsbook selection, snapshotted at placement. The event catalogue is a
/// generated feed, not a table, so a leg stores what the player saw and the
/// price they were given rather than a foreign key into data that can change.
model BetLeg {
  id               String    @id @default(cuid())
  betId            String
  position         Int
  eventId          String
  marketId         String
  selectionId      String
  eventLabel       String
  competitionLabel String
  marketNameKey    String
  marketLine       Float?
  /// A proper noun (a club name) is stored literally; otherwise an i18n key.
  selectionLabel   String
  selectionLabelKey String?
  oddsMilli        Int
  status           LegStatus @default(OPEN)
  startTime        DateTime

  bet Bet @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@index([betId])
  @@index([eventId])
}

/// Server-side commit–reveal seeds for provably fair casino rounds. The secret
/// `serverSeed` is only ever returned after the pair has been rotated out.
model FairnessSeed {
  id             String    @id @default(cuid())
  userId         String
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  /// Rounds played on this pair so far.
  nonce          Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revealedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

/// Free spins won on the slot, owed to the player. Server state because it is
/// worth money: a counter the browser could edit would be unlimited free spins.
model SlotFreeSpins {
  userId    String   @id
  remaining Int      @default(0)
  /// Millimes — the stake the spins were won at, so they cannot be banked at a
  /// low stake and cashed at a high one.
  stake     BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

/// Replay cache for money-moving requests: the same key returns the original
/// response instead of executing twice.
model IdempotencyRecord {
  id        String   @id @default(cuid())
  userId    String
  scope     String
  key       String
  response  Json
  createdAt DateTime @default(now())

  @@unique([userId, scope, key])
  @@index([createdAt])
}

// =============================================================================
// Responsible gambling
// =============================================================================

model ResponsibleGamblingLimit {
  id                   String      @id @default(cuid())
  userId               String
  kind                 LimitKind
  /// SINGLE_BET limits have no period; stored as DAILY and ignored.
  period               LimitPeriod
  /// Millimes.
  value                BigInt
  /// A requested increase waits out the cooling-off window before it applies.
  pendingValue         BigInt?
  pendingEffectiveFrom DateTime?
  active               Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, active])
}

model SelfExclusion {
  id        String        @id @default(cuid())
  userId    String
  kind      ExclusionKind
  startedAt DateTime      @default(now())
  /// null = permanent.
  endsAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
}

// =============================================================================
// Operations
// =============================================================================

/// Immutable by trigger — see the migrations. `actorId` / `targetUserId` are
/// kept (SetNull is never needed: users are closed, not deleted).
model AuditLog {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  action        String
  severity      AuditSeverity @default(INFO)
  outcome       AuditOutcome  @default(SUCCESS)
  actorId       String?
  actorRole     Role?
  /// The player the action concerned, when there is one.
  targetUserId  String?
  targetType    String?
  targetId      String?
  transactionId String?
  description   String
  ip            String?
  userAgent     String?
  requestId     String?
  metadata      Json?

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@index([transactionId])
  @@index([ip])
}

/// Per-recipient. An event for "all administrators" is one row per administrator,
/// so read state needs no join table.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// e.g. "account", "bet_settled", "new_player", "withdrawal_request".
  kind      String
  /// i18n keys; `params` is interpolated at render time.
  titleKey  String
  bodyKey   String
  params    Json?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// A competition (or sport, team, event) a player pinned.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  /// sport | competition | team | event
  kind      String
  targetId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId])
}

/// Operator-editable settings. Keys and value shapes are declared in code
/// (src/server/settings/registry.ts); a row here only overrides a default.
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Fixed-window counters for the rate limiter. A serverless deployment has no
/// shared memory, so limits that guard sign-in and money live in the database.
model RateLimitCounter {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}
